# Platform Postgres (compose interpolates this into DATABASE_URL)
POSTGRES_PASSWORD=

# 32-byte AES-256-GCM key: 64 hex characters (openssl rand -hex 32)
MASTER_ENCRYPTION_KEY=

# Signed session cookie HMAC (openssl rand -hex 32)
SESSION_SECRET=

# First-boot admin (ignored once an admin row exists)
ADMIN_EMAIL=d.stredansky@gmail.com
ADMIN_PASSWORD=

PUBLIC_DASHBOARD_URL=https://mcp.stredan.sk
COOKIE_SECURE=true
NODE_ENV=production
PORT=3000

# Local-only: set when running `npm run dev` without compose
# DATABASE_URL=postgres://agentmcp:agentmcp@127.0.0.1:5439/agentmcp
