generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Technology {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?  // path napr. /icons/technologies/nextdotjs.svg
  category  String?  // framework, language, database, tool, etc.
  sortOrder Int      @default(0)
  projects  ProjectTechnology[]
}

model Integration {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?  // path napr. /icons/integrations/google.svg
  category  String?  // auth, maps, kyc, payments, etc.
  sortOrder Int      @default(0)
  projects  ProjectIntegration[]
}

model ProjectBadge {
  id        String  @id
  projectId String
  badge     String  // marketplace, open-source, etc.
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  @@id([projectId, technologyId])
}

model ProjectIntegration {
  projectId     String
  integrationId String
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  @@id([projectId, integrationId])
}

model Project {
  id            String   @id @default(cuid())
  titleEn       String
  titleSk       String
  slug          String   @unique
  descriptionEn String?
  descriptionSk String?
  url          String?
  appStoreUrl  String?
  playStoreUrl String?
  logo         String?  // path napr. /logos/my-project.png
  category     String   @default("personal")
  year         Int?
  featured     Boolean  @default(false)
  sortOrder    Int      @default(0)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  technologies ProjectTechnology[]
  integrations ProjectIntegration[]
  badges       ProjectBadge[]
}

model Job {
  id            String   @id @default(cuid())
  slug          String   @unique
  companyEn     String
  companySk     String
  positionEn    String
  positionSk    String
  descriptionEn String?
  descriptionSk String?
  url           String?
  urlLabelEn    String?
  urlLabelSk    String?
  startYear     Int
  endYear       Int?
  current       Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Leadgen / offer lab (AI SME outbound) ───────────────────────────

enum OfferStatus {
  draft
  active
  paused
  retired
}

enum LeadStatus {
  sourced
  enriching
  enriched
  scored
  queued
  contacted
  replied
  meeting
  won
  lost
  suppressed
  skipped
}

enum TouchChannel {
  resend
  gmail
  smtp
}

enum TouchStatus {
  draft
  queued
  sent
  delivered
  opened
  replied
  bounced
  failed
  unsubscribed
}

enum ReplyIntent {
  interested
  not_now
  wrong_person
  unsubscribe
  bounce
  ooo
  unclear
  other
}

model Offer {
  id              String      @id @default(cuid())
  code            String      @unique // A | B | C | D | E
  slug            String      @unique
  nameSk          String
  nameEn          String
  oneLinerSk      String
  oneLinerEn      String
  ctaSk           String
  ctaEn           String
  priceHintSk     String?
  priceHintEn     String?
  icpNotesSk      String?
  icpNotesEn      String?
  notForSk        String?
  notForEn        String?
  landingPath     String // e.g. /offers/ai-audit
  status          OfferStatus @default(draft)
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  templates       EmailTemplate[]
  touches         Touch[]
  scores          LeadScore[]
  experimentDays  ExperimentDaily[]
}

// Sending identity (matrix columns 1–5). Content is Offer A–E, not this.
model SendAccount {
  id              String       @id @default(cuid())
  code            String       @unique // "1" | "2" | "3" | "4" | "5"
  name            String
  mcpAccountKey   String? // Email MCP account key (filled in admin / mcp.stredan.sk)
  channel         TouchChannel @default(gmail)
  fromAddress     String?
  dailyCap        Int          @default(8)
  active          Boolean      @default(false)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  touches         Touch[]
  experimentDays  ExperimentDaily[]
}

model EmailTemplate {
  id              String       @id @default(cuid())
  offerId         String
  offer           Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  key             String // e.g. cold-1, cold-2, bump
  locale          String       @default("sk")
  subject         String
  bodyText        String
  bodyHtml        String?
  version         Int          @default(1)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  touches         Touch[]

  @@unique([offerId, key, locale, version])
  @@index([offerId, active])
}

model Company {
  id              String   @id @default(cuid())
  rpoId           Int?     @unique // rpo2.organizations.id
  ico             String?  @unique
  name            String
  legalForm       String?
  naceCode        String?
  naceLabel       String?
  city            String?
  region          String?
  establishedAt   DateTime?
  terminatedAt    DateTime?
  website         String?
  sourceRegister  String?
  rawRpo          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  leads           Lead[]

  @@index([naceCode])
  @@index([city])
  @@index([legalForm])
}

model Lead {
  id              String     @id @default(cuid())
  companyId       String     @unique
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status          LeadStatus @default(sourced)
  assignedOfferId String?
  batchId         String?
  notes           String?
  skipReason      String? // no_site | no_email | shell | it_internal | bad_ico
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  contacts        LeadContact[]
  enrichments     LeadEnrichment[]
  scores          LeadScore[]
  touches         Touch[]

  @@index([status])
  @@index([batchId])
  @@index([assignedOfferId])
  @@index([skipReason])
}

model LeadContact {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fullName        String?
  role            String?
  email           String?
  emailSource     String? // website, pattern, public, manual
  emailVerified   Boolean  @default(false)
  phone           String?
  linkedinUrl     String?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  touches         Touch[]

  @@unique([leadId, email])
  @@index([leadId])
  @@index([email])
}

model LeadEnrichment {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentRunId      String?
  provider        String // cursor-agent | manual | script
  kind            String // search | people | website
  inputJson       Json
  outputJson      Json
  confidence      Float?
  createdAt       DateTime @default(now())

  @@unique([leadId, kind])
  @@index([leadId])
  @@index([agentRunId])
}

model LeadScore {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  offerId         String
  offer           Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  agentRunId      String?
  score           Int // 0-100
  rationaleSk     String?
  rationaleEn     String?
  inputJson       Json?
  outputJson      Json?
  createdAt       DateTime @default(now())

  @@unique([leadId, offerId])
  @@index([score])
}

model Touch {
  id              String       @id @default(cuid())
  leadId          String
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         LeadContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  offerId         String
  offer           Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  templateId      String?
  template        EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sendAccountId   String?
  sendAccount     SendAccount? @relation(fields: [sendAccountId], references: [id], onDelete: SetNull)
  channel         TouchChannel
  accountKey      String? // Email MCP account key (denorm of SendAccount.mcpAccountKey)
  status          TouchStatus  @default(draft)
  subject         String
  bodyText        String
  bodyHtml        String?
  personalization Json?
  providerMessageId String?
  sentAt          DateTime?
  error           String?
  replyIntent     ReplyIntent?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  events          TouchEvent[]

  @@index([leadId])
  @@index([offerId, status])
  @@index([channel, status])
  @@index([sendAccountId, status])
  @@index([offerId, sendAccountId, sentAt])
  @@index([sentAt])
}

model TouchEvent {
  id              String   @id @default(cuid())
  touchId         String
  touch           Touch    @relation(fields: [touchId], references: [id], onDelete: Cascade)
  type            String // sent | open | click | reply | bounce | unsubscribe
  payload         Json?
  createdAt       DateTime @default(now())

  @@index([touchId])
  @@index([type])
}

model AgentRun {
  id              String   @id @default(cuid())
  kind            String // daily-batch | enrich | score | send | reply-triage | eval
  status          String // running | succeeded | failed | partial
  trigger         String // schedule | manual | cloud-agent
  inputJson       Json?
  outputJson      Json?
  summary         String?
  error           String?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  costHintUsd     Float?

  @@index([kind, startedAt])
  @@index([status])
}

model Suppression {
  id              String   @id @default(cuid())
  email           String?  @unique
  ico             String?
  reason          String
  source          String? // reply | manual | bounce
  createdAt       DateTime @default(now())

  @@index([ico])
}

model ExperimentDaily {
  id              String      @id @default(cuid())
  day             DateTime    @db.Date
  offerId         String
  offer           Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sendAccountId   String
  sendAccount     SendAccount @relation(fields: [sendAccountId], references: [id], onDelete: Cascade)
  sent            Int         @default(0)
  replied         Int         @default(0)
  interested      Int         @default(0)
  meetings        Int         @default(0)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([day, offerId, sendAccountId])
}

model CursorHandle {
  handle            String   @id
  displayName       String   @default("")
  joinedDate        String   @default("")
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  requestCount      Int      @default(0)
  lastTotalTokens   BigInt   @default(0)
  lastCurrentStreak Int      @default(0)
  lastLongestStreak Int      @default(0)
  lastError         String?
}

model CursorProfileSnapshot {
  id              String   @id @default(cuid())
  handle          String
  capturedAt      DateTime @default(now())
  displayName     String
  joinedDate      String
  totalTokens     BigInt
  currentStreak   Int
  longestStreak   Int
  mostActiveMonth String
  mostActiveDay   String
  agentsLocal     Int
  agentsCloud     Int
  profile         Json

  @@index([handle, capturedAt])
}
