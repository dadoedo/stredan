# Copied to /root/stredan/.env on first CI deploy (not overwritten later).
# Rotate on the server + update GitHub Environment secrets if you re-bootstrap.

# Must match the existing Postgres role password on stredan_pgdata
# (Postgres only reads POSTGRES_PASSWORD on first volume init).
POSTGRES_PASSWORD=stredan_secret

# Admin login at /admin (and later admin.stredan.sk)
ADMIN_PASSWORD=change-me

# PostHog (EU) — baked into the Next.js client bundle at image build time,
# and also used at runtime by posthog-node. Set the GitHub Environment
# secret NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN on stredan-production.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

NODE_ENV=production

# R2 heatmap cache (AllDevs account bucket stredan-cursor-profile)
R2_ACCOUNT_ID=
R2_BUCKET=stredan-cursor-profile
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
