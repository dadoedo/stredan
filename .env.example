# Database (lokálne: SSH tunel na port 5457 — Host alldevs-hetzner)
DATABASE_URL="postgresql://stredan:stredan_secret@localhost:5457/stredan"

# Admin panel (/admin) — produkčný bootstrap cez GitHub Environment stredan-production
ADMIN_PASSWORD="tvoje-tajne-heslo"

# Voliteľné: rovnaké meno ako na produkcii (compose)
POSTGRES_PASSWORD="stredan_secret"

# PostHog (EU) — Project API key z https://eu.posthog.com/settings/project
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
